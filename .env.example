# Copy to .env and fill in real values. Never commit the real .env file
# (see DEPLOYMENT.md — this lives only in a .env file on the VPS, read by
# Docker Compose, and never in the repo).

# --- App: database ---------------------------------------------------
DATABASE_URL="postgresql://user:password@localhost:5432/modernist14?schema=public"

# --- Tests: test database (see TESTING.md → Test database) -----------
# A second database on the SAME Postgres instance the dev docker-compose
# stack already runs — no separate container needed locally. Vitest swaps
# DATABASE_URL to this value for the test run (see vitest.setup.ts).
DATABASE_URL_TEST="postgresql://user:password@localhost:5432/modernist14_test?schema=public"

# --- App: NextAuth (single admin — see SPEC.md §8) --------------------
# The admin account itself isn't an env var — create/reset it with
# `npm run admin:create -- <email> <password>` (see scripts/create-admin.ts).
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_URL="https://modernist14.local"

# --- App: Nominatim geocoding (see lib/geocode.ts, SPEC.md §5.6) -----
# Base URL of the Nominatim instance. Defaults to the public endpoint if
# unset — override for a self-hosted instance or, in tests, a local stub.
NOMINATIM_URL="https://nominatim.openstreetmap.org"
# Required by Nominatim's usage policy: a descriptive User-Agent
# identifying the app and a contact address.
NOMINATIM_USER_AGENT="modernist14/1.0 (contact@modernist14.local)"

# --- App: Hetzner Object Storage (S3-compatible, photo uploads) ------
STORAGE_ENDPOINT="https://<region>.your-objectstorage.com"
STORAGE_REGION="eu-central"
STORAGE_BUCKET="modernist14-photos"
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""

# --- App: Resend (transactional email — moderation notifications) ----
RESEND_API_KEY=""
RESEND_FROM_EMAIL="notifications@modernist14.local"
ADMIN_NOTIFICATION_EMAIL="admin@modernist14.local"

# --- App: Cloudflare Turnstile (CAPTCHA on public submission forms) --
TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# --- docker-compose.yml: Postgres (app db) ----------------------------
POSTGRES_USER="modernist14"
POSTGRES_PASSWORD=""
POSTGRES_DB="modernist14"

# --- docker-compose.yml: Umami (self-hosted analytics) + its own db --
UMAMI_POSTGRES_USER="umami"
UMAMI_POSTGRES_PASSWORD=""
UMAMI_POSTGRES_DB="umami"
UMAMI_APP_SECRET="generate-with-openssl-rand-base64-32"
UMAMI_DOMAIN="analytics.modernist14.local"

# --- docker-compose.yml: image + routing ------------------------------
GHCR_OWNER=""
GHCR_REPO="modernistfourteenth"
APP_DOMAIN="modernist14.local"
